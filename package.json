{
  "name": "vue-monorepo",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:oxlint": "oxlint apps/tugas-1-vue-3-foundation --fix",
    "format": "prettier --write --experimental-cli apps/tugas-1-vue-3-foundation/src/",
    "type-check": "turbo run type-check",
    "test": "turbo run test:unit"
  },
  "devDependencies": {
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "turbo": "^2.0.0"
  }
}
