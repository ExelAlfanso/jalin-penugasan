{
  "name": "vue-sfc-transformer",
  "type": "module",
  "version": "0.2.5",
  "description": "Tools for minimal TypeScript transpilation of Vue SFCs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "nuxt-contrib/vue-sfc-transformer"
  },
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./mkdist": "./dist/mkdist.mjs",
    "./rolldown": "./dist/rolldown.mjs",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@volar/typescript": "^2.4.0",
    "@vue/compiler-core": "^3.5.13",
    "@vue/language-core": "^3.0.0",
    "esbuild": "*",
    "rolldown": ">=1.0.0-beta.0",
    "typescript": ">=5.0.0",
    "vue": "^3.5.13"
  },
  "peerDependenciesMeta": {
    "@volar/typescript": {
      "optional": true
    },
    "@vue/language-core": {
      "optional": true
    },
    "rolldown": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@babel/parser": "^7.27.0",
    "pathe": "^2.0.3",
    "tinyglobby": "^0.2.16"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.2.0",
    "@babel/types": "7.29.7",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "@volar/typescript": "2.4.28",
    "@vue/compiler-core": "3.5.40",
    "@vue/compiler-dom": "3.5.40",
    "@vue/language-core": "3.3.8",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "exsolve": "1.1.0",
    "installed-check": "10.0.1",
    "knip": "6.29.0",
    "lint-staged": "17.2.0",
    "mkdist": "2.4.1",
    "pkg-pr-new": "0.0.80",
    "rolldown": "1.2.0",
    "simple-git-hooks": "2.13.1",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "vue": "3.5.40",
    "vue-tsc": "3.3.8"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs,json,.*rc}": [
      "npx eslint --fix"
    ]
  },
  "scripts": {
    "build": "tsdown",
    "dev": "vitest dev",
    "lint": "eslint .",
    "test": "pnpm test:unit && pnpm test:types",
    "test:unit": "vitest",
    "test:knip": "knip",
    "test:versions": "installed-check -d --no-workspaces -i rolldown",
    "test:types": "tsc --noEmit"
  }
}